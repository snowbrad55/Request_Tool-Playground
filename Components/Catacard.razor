 @using TyphoonTaskingTool.Components.Pages
@using TyphoonTaskingTool.Components.RigForms
@inject IDialogService DialogService

<MudPaper>
	<MudCard Style="width:300px; max-width:100%; height:400px; max-height:100%">
		<MudCardHeader Style="background-color:darkred; color:aliceblue">
			<MudText Typo="Typo.h6">@title</MudText>
		</MudCardHeader>
		<MudCardMedia  Image=@imagePath Height="150"/>
		<MudCardContent>
			<MudText Typo="Typo.body2">@description</MudText>
			<MudText Typo="Typo.body2" Color="Color.Error">@warning</MudText>
		</MudCardContent>
		<MudCardActions Class="pa-4">
			<MudButton Variant="Variant.Filled"
			  Color="Color.Primary"
			  OnClick="@(() => OpenDialog())">Request</MudButton>
		</MudCardActions>
	</MudCard>
</MudPaper>

@code {

	private async Task OpenDialog()
	{
		var options = new DialogOptions
		{
			CloseButton = true,
			MaxWidth = MaxWidth.Large,
			FullWidth = true,
            BackdropClick = false,
        };
        await DialogService.ShowAsync(DialogComponent, title, options);
		
	}

    [Parameter] public Type DialogComponent { get; set; } = default!;

	[Parameter] public string? title { get; set; } = "<TITLE_GOES_HERE>";
	[Parameter] public string? imagePath { get; set; } = "<IMAGE_PATH>";
	[Parameter] public string? description { get; set; } = "<DESCRIPTION>";
	[Parameter] public string? warning { get; set; } = "<WARNING>";

}
