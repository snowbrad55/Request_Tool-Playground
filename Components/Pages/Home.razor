@page "/"

<PageTitle>Typhoon MSC: Portal</PageTitle>
<MudLayout>
	<div class="fullscreen-background">
	</div>
	<MudMainContent>
			<MudContainer Class="d-flex justify-content-center align-content-center">
				<MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">

					<MudText Align="Align.Center" Typo="Typo.h2">Typhoon Mission Support Centre</MudText>
				<MudText Align="Align.Center" Typo="Typo.h2">Task Request Management Application</MudText>
					<MudGrid Justify="Justify.Center">
						<MudItem>
							<MudImage Width="200" Fluid="true" Src="images/8556ad2d-facd-4e2e-af1d-3a0b3e529263.png" Alt="TMSC Badge" Elevation="0" />
						</MudItem>
					</MudGrid>
					<MudText Align="Align.Center" Typo="Typo.body1">Information processed by this application is to be classified at OFFICIAL only. Contact the Ty MSC if you require information processing above OFFICIAL SENSITIVE</MudText>
					<MudText Align="Align.Center" Typo="Typo.body1"><strong>This application was developed in-house by Ty MSC IxTS team. Any questions or comments regarding the application should be forwarded to IxTS in the first instance.</strong></MudText>
				</MudStack>
			</MudContainer>
	</MudMainContent>
</MudLayout>




